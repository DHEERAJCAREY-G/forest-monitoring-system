# Firebase Configuration Template for Intelligent Forest Monitoring System
# Copy this file to .env and fill in your actual Firebase project credentials

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# MapTiler API Configuration (Optional: provides global English satellite hybrid vector labels)
# Obtain a free key at https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here
